# Postgres (compose.yaml 기본값과 동일)
DATABASE_URL=postgres://commerce@127.0.0.1:5432/commerce
DATABASE_PASSWORD_FILE=.secrets/pg-password
# 세션 서명 비밀. 공백이면 개발용 기본값 사용. 운영에서는 반드시 설정
SESSION_SECRET=
# 테스트 사용자 접근 코드 매핑: 코드=auth_subject 쌍, 콤마 구분 (Phase 1 users 테이블과 연결)
TEST_USER_CODES=demo-a=u-a,demo-b=u-b,demo-c=u-c,demo-d=u-d
# Six-user QA only: requires the validated local test_items DB and explicit SESSION_SECRET.
# QA_AUTH_FILE is an absolute Git-excluded hash-only file; never use the admin plaintext file.
QA_AUTH_ENABLED=0
QA_AUTH_FILE=
# Exact HTTPS BRAIN_PUBLIC_ORIGIN is required when published; QA cookies then include Secure.
# LLM Provider API format: responses (default) | chat_completions | anthropic_messages
LLM_API_FORMAT=responses
# Existing OpenAI Responses API defaults remain compatible. For an approved
# OpenAI-compatible endpoint, set its URL, API format, model ID and key explicitly.
# Optional only for an Anthropic provider confirmed to support it; otherwise leave unset.
# LLM_ANTHROPIC_THINKING=adaptive
# LLM_ANTHROPIC_EFFORT=high
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=xhigh
LLM_API_TIMEOUT_MS=180000
# Normal recommendation explanation deadline (milliseconds); no additional model calls.
BRAIN_RECOMMENDATION_TIMEOUT_MS=120000
# Optional server-owned, Git-excluded JSONL path. Metadata only; never prompts or replies.
LLM_DIAGNOSTICS_FILE=
# 1: v0.6 읽기 전용 AI 시연. 카트/주문 등 일반 Commerce 변경 API도 차단됨
# 0: 기존 Commerce 동작 유지. AI 시연은 별도 서버에서 1로 설정
AI_LIVE_DEMO=0
# LLM_PROVIDER: live | stub (기본: 키 있으면 live, 없으면 stub. stub은 조회만 수행)
LLM_PROVIDER=

# Brain API (별도 AI DB에 001~004 마이그레이션 승인 후에만 활성화)
# Brain routing: rules (default) or decisions (OpenAI classification + configured conversation provider).
BRAIN_ROUTE_MODE=rules
# Server-only Decisions key; falls back to OPENAI_API_KEY, independent of Claude LLM_API_KEY.
OPENAI_DECISIONS_API_KEY=
BRAIN_DECISIONS_TIMEOUT_MS=4000
BRAIN_DECISIONS_CONFIDENCE=0.35
BRAIN_ENABLED=0
# Explicit QA catalog source only: public (normal) or test_items (read-only v4 demo).
# test_items requires an unprivileged SELECT-only toss role and blocks Commerce writes.
COMMERCE_CATALOG_SOURCE=public
# Optional external catalog; local DATABASE_URL continues to own users/cart/orders.
# Separate read-only pool, explicit dataset schema and TLS validation; unprivileged role by default.
CATALOG_DATABASE_URL=
CATALOG_DATABASE_PASSWORD_FILE=
CATALOG_DATABASE_SSL_CA_FILE=
# Optional server certificate pin; normal TLS chain and hostname checks still apply.
CATALOG_DATABASE_SERVER_CERT_FILE=
# Optional explicitly approved administrator role; read-only session and fixed catalog SELECTs still apply.
CATALOG_DATABASE_APPROVED_ADMIN_ROLE=
BRAIN_DATABASE_URL=
# 공개 호스트로 Brain API 제공 시 반드시 정확한 HTTPS origin 설정
# 예시: https://shopping.example.com (경로·끝 슬래시 없이)
BRAIN_PUBLIC_ORIGIN=
# RAG URL example only. Configure BRAIN_RAG_URL only for an approved local/service endpoint.
# Example: http://127.0.0.1:18082/v1/rag/search
BRAIN_RAG_URL=
# Explicit opt-in only. remote preserves the existing RAG URL/tunnel path.
BRAIN_RAG_MODE=remote
# Explicit remote profile, independently validated against response.profile_name.
BRAIN_RAG_PROFILE=
# local: absolute extracted corpus path; never commit corpus/embedding files.
BRAIN_RAG_DATA_DIR=
# Local offline encoder: pinned W02 venv + model cache. No automatic download/remote fallback.
BRAIN_RAG_PYTHON=
BRAIN_RAG_MODEL_REVISION=
BRAIN_RAG_MODEL_CACHE=
# Optional absolute deployment-owned JSON manifest: dataset ID/version, catalog source,
# categories, encoder model/dimensions/pinned revision and both corpus SHA-256 values.
# Unset preserves v4 compatibility. Corpus, model cache and manifest stay outside Git.
BRAIN_RAG_MANIFEST_PATH=
# DATA_DIR is the directory containing evidence_chunks.jsonl and indexed_products.jsonl,
# i.e. <extracted-root>/database_exports/toss_rag/rag (not the extracted root itself).
# Approved corpus version: test_items:sha256=4e9924492dcb536e:products=180:reviews=4737
# v4 or legacy (legacy maps to the existing brain-rag-v1 contract).
BRAIN_RAG_CONTRACT=v4
# Exact deployed dataset_version; required for v4 and intentionally left blank here.
BRAIN_RAG_DATASET_VERSION=
# Current query profile category.
BRAIN_RAG_CATEGORY=beauty
# Required by the legacy contract; not a substitute for source verification.
BRAIN_RAG_AUDIT_ID=
BRAIN_RAG_TOKEN=
